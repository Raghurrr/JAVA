package com.raghu.SteamAPI;
import java.util.stream.*;
import java.util.Comparator;
import java.util.List;
public class SortStream 
{
	public static void main(String[] args)
	{
		//Sorting in a Natural Order
		
		List<String> list1=  List.of("Raghava","kiran","zyan","Bhaskar","anirudh");
		list1.stream().sorted().forEach(System.out::println);
		System.out.println();
		List<Integer> list2= List.of(50,30,10,20,80);
	    list2.stream().sorted().forEach(System.out::println);
	    System.out.println();
	    
	    list1.stream().sorted().collect(Collectors.toList()).forEach(System.out::println);
	    
	    System.out.println();
	    
	   list2.stream().sorted().collect(Collectors.toList()).forEach(n->System.out.println(n));
		
	    System.out.println();

	  //Sorting in a custom order using comparator
	    
	    list2.stream().sorted(new IntComparator()).collect(Collectors.toList()).forEach(n->System.out.print(n+"\t"));
	    
	    System.out.println();
	    
	    list1.stream().sorted(new StringComparator()).collect(Collectors.toList()).forEach(n->System.out.print(n+"\t"));
	    
	    System.out.println();
	    
	    list1.stream().sorted(new StringComparator1()).collect(Collectors.toList()).forEach(n->System.out.print(n+"\t"));

	    
	    
	
	}
	
	
	

}


class IntComparator implements Comparator<Integer>
{

	public int compare(Integer o1, Integer o2)
	{
		if(o1>o2)
		return -1;
		else if(o2>o1)
			return 1;
		else
			return 0;
	}
	
}



class StringComparator implements Comparator<String>
{

	@Override
	public int compare(String o1, String o2) {
		
		return - o1.compareTo(o2);
	}
	
}


class StringComparator1   implements Comparator<String>
{

	@Override
	public int compare(String o1, String o2) {
		
		if(o1.length()>o2.length())
			return -1;
		else if(o1.length()<o2.length())
			return 1;
		else
			return 0;
			
	}
	
}
