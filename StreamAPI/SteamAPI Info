package com.raghu.java8features;


import java.util.Arrays;
import java.util.List;
import java.util.stream.*;



public class SteamAPI 
{
	public static void main(String[] args) 
	{
		
		 // Using Stream.of() Method.
		
		System.out.println("Using Stream.of() Method.");
		
		Stream<Integer> st1= Stream.of(10,20,30,30,40,90,9);
		st1.forEach(ele->System.out.println(ele));
		System.out.println();
		Stream<Integer> st2=Stream.of(10,20,30,30,40);
		Stream<Integer> st3=st2.filter(ele->ele%2==0);
		st3.forEach(ele->System.out.println(ele));
		System.out.println();
		IntStream stm4=IntStream.range(1,20);
		//stm4.forEach(ele->System.out.println(ele));
		IntStream stm5 = stm4.filter(ele->ele%2 != 0);
		stm5.forEach(System.out::println);
		System.out.println();
		
		
		// Using Array.stream() method.
		
		System.out.println(" Using Array.stream() method.");
		
		int arr[] = {1,2,3,4,5,10,20,30,40,50};
		IntStream stm6 = Arrays.stream(arr); 
		IntStream stm7 = stm6.filter(ele->ele>10);
		stm7.forEach(ele->System.out.println(ele));
	    System.out.println();
	    
	    int arr1[] = {1,2,3,4,5,10,20,30,40,50};
	    IntStream stm8 = Arrays.stream(arr1); 
	    IntStream stm9 = stm8.filter(ele->ele%2==0);
	    stm9.forEach(System.out::println);
	    System.out.println();
		
	    String arr2[] = {"raghu","raju","Vijay","Kiran","Tarun"};
	    Stream<String> stm10 = Arrays.stream(arr2);
	    stm10.forEach(System.out::println);
	    System.out.println();
	    
	    
	    //Using Collection Object.
	    
	    System.out.println("Using Collection Object.");
	    
	    
	    List<Integer> list1  = List.of(100,200,300,400,500);
	    Stream<Integer> stm11 = list1.stream();
	    stm11.forEach(System.out::println);
	    System.out.println();
	    
	    
	    List<String> list2  = List.of("Raghava","Raju","Nakka","Vijay","Tarun");
	    Stream<String> stm12 = list2.stream();
	    Stream<String> stm13 = stm12.filter(s->s.startsWith("R"));
	    stm13.forEach(System.out::println);
	}

}
