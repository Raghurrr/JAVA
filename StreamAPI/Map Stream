package com.raghu.SteamAPI;
import com.raghu.SteamAPI.*;

import java.util.List;

public class MapStream 
{
	public static void main(String[] args)
	{
		List<Object> list1=List.of("a","b","c",5,4,6);
		list1.stream().
		map(ele->ele.toString()+5).
		forEach(System.out::println);
		System.out.println();
		list1.stream().
		map(ele->ele.toString()).
		forEach(ele->System.out.println(ele.toUpperCase()));
		System.out.println();
		list1.stream().
		map(ele->5).
		forEach(System.out::println);
		System.out.println();
		list1.stream().
		map(ele->5).
		forEach(ele->System.out.println(ele+4));
		System.out.println();
		list1.stream().
		filter(obj->obj instanceof String).
		map(obj->obj.toString()). // we an also here directly use like this 'map(obj->obj.toString().toUpperCase())'
		forEach(ele->System.out.print(ele.toUpperCase()+" "));
		System.out.println();
		
		
	    
		
		
	}

}
